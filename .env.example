# ---- Google Sheet (the database) ----
SHEET_ID=1iUECISYXuIy-t099l5HytXa5-PgTniSye24UItYI8oU
# Paste the whole service-account JSON key (raw JSON or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- App ----
APP_URL=https://your-app.up.railway.app
DATA_DIR=/data                # mount a Railway volume here — clicks are stored here first
DAILY_CAP=10
DEDUPE_DAYS=7                 # same customer not messaged again by ANY agent within 7 days (0 = off)
FLUSH_MS=120000               # Railway → sheet every 2 min
RELOAD_MIN=5                  # sheet → Railway (new leads, template edits) every 5 min
REPORT_MIN=10                 # Dashboard + AgentLinks refresh
REOPEN_MIN=15                 # agent can re-open WhatsApp for a lead they just sent (page died)
ADMIN_TOKEN=change-me-long-random-string
LINK_SECRET=                  # optional: signs agent links (?agent=phone.sig)
REQUIRE_SIGNED_LINKS=false    # true = reject unsigned ?agent=phone links
RUN_CRONS=true
BLAST_ENABLED=1               # 0 = don't send the 9:30 agent-link blast from Railway
DEFAULT_CHANNEL=WHATSAPP      # agents with a blank channel in the Agents tab: WHATSAPP | EMAIL | BOTH | NONE

# ---- Email (agent links by email; any SMTP — Gmail/Workspace needs an App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cx-outreach@rupeek.com
SMTP_PASS=
MAIL_FROM=Rupeek CX Team <cx-outreach@rupeek.com>

# ---- Gupshup (use a ROTATED key) ----
