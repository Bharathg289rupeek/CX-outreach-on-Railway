# ---- Railway injects DATABASE_URL automatically when you reference the Postgres service ----
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Google Sheet ----
SHEET_ID=your-google-sheet-id
# Paste the whole service-account JSON key (raw JSON or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- App ----
PUBLIC_URL=https://your-app.up.railway.app
DAILY_CAP=10
CX_COOLDOWN_DAYS=7            # same customer won't be messaged again by ANY agent within 7 days (0 = off)
SYNC_EVERY_MIN=2
REPORT_EVERY_N_SYNCS=5        # Dashboard/AgentLinks refresh every 5th sync (~10 min)
ADMIN_TOKEN=change-me-long-random-string
LINK_SECRET=change-me-another-long-random-string   # signs agent links (?agent=phone.sig)
REQUIRE_SIGNED_LINKS=false    # set true once the new Gupshup template is live
RUN_CRONS=true
TZ=Asia/Kolkata

# ---- Gupshup (use a ROTATED key) ----
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=91XXXXXXXXXX
GUPSHUP_APP=your-gupshup-app-id
GUPSHUP_TEMPLATE_ID=your-template-id
